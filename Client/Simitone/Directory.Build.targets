<Project>

  <!--
    Imported automatically by MSBuild *after* every project file inside
    "Client/Simitone".

    FreeSO's engine projects hard code "MonoGame.Framework.DesktopGL 3.8.4".
    The Simitone projects use $(MonoGameVersion) instead, and because NuGet
    resolves one version per package across a whole project graph, the highest
    requested version wins - so raising $(MonoGameVersion) moves the whole
    graph (including the submodule) forward without touching the submodule.
  -->
  <ItemGroup>
    <PackageReference Update="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)" />
    <PackageReference Update="MonoGame.Framework.WindowsDX" Version="$(MonoGameVersion)" />
    <PackageReference Update="MonoGame.Content.Builder.Task" Version="$(MonoGameVersion)" />
  </ItemGroup>

</Project>
