<Project>

  <!--
    Shared MSBuild properties for the Simitone projects (Simitone.Client,
    Simitone.Windows, Simitone.Touch and Simitone.Android).

    NOTE: this file intentionally lives in "Client/Simitone" and *not* in the
    repository root, so that the projects inside the "FreeSO" git submodule are
    not affected by it. The submodule is kept byte-for-byte identical to
    upstream, which makes it trivial to rebase onto a new FreeSO release.

      * MonoGameVersion     - the MonoGame NuGet version used by every Simitone
                              project. The engine projects inside the FreeSO
                              submodule pin MonoGame.Framework.DesktopGL 3.8.4;
                              NuGet unifies package versions across a project
                              graph, so raising this value moves the whole graph
                              forward at once (see Directory.Build.targets).
      * SimitoneLangVersion - language version used by the new code.
  -->

  <PropertyGroup>
    <MonoGameVersion Condition="'$(MonoGameVersion)' == ''">3.8.4</MonoGameVersion>
    <SimitoneLangVersion Condition="'$(SimitoneLangVersion)' == ''">latest</SimitoneLangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Company>nilsvaupel10-prog</Company>
    <Product>Simitone</Product>
    <Copyright>Simitone / FreeSO contributors</Copyright>
    <Version>1.0.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

</Project>
