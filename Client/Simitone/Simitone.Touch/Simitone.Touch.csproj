<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Simitone.Touch - the self contained on-screen control system.

    This assembly deliberately has *no* dependency on the FreeSO engine or on
    Simitone.Client. It only knows about MonoGame primitives, which keeps it
    easy to unit test, easy to re-theme and easy to reuse (the same module can
    drive a future iOS build).

    The bridge that connects this module to the FreeSO input pipeline lives in
    Simitone.Client (see UI/Touch/TouchControlBridge.cs).
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Simitone.Touch</RootNamespace>
    <AssemblyName>Simitone.Touch</AssemblyName>
    <LangVersion>$(SimitoneLangVersion)</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The control icons are embedded in the assembly so that the overlay works
      no matter where the game is installed (Android assets, a zip, a Steam
      folder...). The very same PNG files are also copied next to the assembly
      so that they can be inspected/replaced by users.
    -->
    <EmbeddedResource Include="Resources\TouchIcons\*.png">
      <LogicalName>Simitone.Touch.Resources.TouchIcons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Content Include="Resources\TouchIcons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Resources\TouchIcons\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
